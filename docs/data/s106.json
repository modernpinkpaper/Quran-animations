{"n":106,"verses":[{"k":1,"w":[["لِإِيلَـٰفِ","lieelaafi"],["قُرَيْشٍ","qurayshin"]],"en":"For the accustomed security of the Quraysh -","t":{"6":[[550,2380],[2390,4880]],"12":[[350,2100],[2110,3570]],"7":[[30,1220],[1230,3890]],"9":[[150,1600],[1610,2950]]}},{"k":2,"w":[["إِۦلَـٰفِهِمْ","eelaafihim"],["رِحْلَةَ","rih'lata"],["ٱلشِّتَآءِ","l-shitaai"],["وَٱلصَّيْفِ","wal-sayf"]],"en":"Their accustomed security [in] the caravan of winter and summer -","t":{"6":[[500,2760],[2770,4190],[4200,7090],[7100,9870]],"12":[[400,2630],[2640,3840],[3850,6480],[6490,8000]],"7":[[30,1480],[1490,2260],[2270,4900],[4910,8200]],"9":[[200,1920],[1930,2870],[2880,5550],[5560,7180]]}},{"k":3,"w":[["فَلْيَعْبُدُوا۟","falya'budoo"],["رَبَّ","rabba"],["هَـٰذَا","haadhaa"],["ٱلْبَيْتِ","l-bayt"]],"en":"Let them worship the Lord of this House,","t":{"6":[[900,3190],[3200,4290],[4300,5470],[5480,8180]],"12":[[400,2490],[2500,3370],[3380,4020],[4030,6030]],"7":[[30,1400],[1410,2060],[2070,2710],[2720,5430]],"9":[[250,1950],[1960,2740],[2750,3580],[3590,4750]]}},{"k":4,"w":[["ٱلَّذِىٓ","alladhee"],["أَطْعَمَهُم","at'amahum"],["مِّن","min"],["جُوعٍۢ","joo'in"],["وَءَامَنَهُم","waaamanahum"],["مِّنْ","min"],["خَوْفٍۭ","khawfin"]],"en":"Who has fed them, [saving them] from hunger and made them safe, [saving them] from fear.","t":{"6":[[300,2670],[2680,5240],[5250,6350],[6360,8180],[8190,11270],[11280,11910],[11920,12490]],"12":[[450,2920],[2930,5200],[5210,6100],[6110,7850],[7860,10450],[10460,10960],[10970,11980]],"7":[[40,2280],[2290,4330],[4340,5400],[5410,6260],[6270,9480],[9490,9840],[9850,10230]],"9":[[350,2650],[2660,4920],[4930,5900],[5910,7440],[7450,10000],[10010,10440],[10450,11540]]}}]}