5740,7820],[7830,10500]],"9":[[600,1780],[1790,2890],[2900,3870],[3880,4750],[4760,6380],[6390,7050],[7060,8540],[8550,10210]]}},{"k":9,"w":[["خَـٰلِدِينَ","khaalideena"],["فِيهَا ۖ","feehaa"],["وَعْدَ","wa'da"],["ٱللَّهِ","l-lahi"],["حَقًّۭا ۚ","haqqan"],["وَهُوَ","wahuwa"],["ٱلْعَزِيزُ","l-'azeezu"],["ٱلْحَكِيمُ","l-hakeem"]],"en":"Wherein they abide eternally; [it is] the promise of Allah [which is] truth. And He is the Exalted in Might, the Wise.","t":{"6":[[300,2010],[2020,4550],[6150,7320],[7330,8260],[8270,10800],[11910,12760],[12770,14450],[14460,15380]],"12":[[350,1760],[1770,3150],[6250,7190],[7200,7950],[7960,9300],[12600,13140],[13150,14390],[14400,15890]],"7":[[30,1060],[1070,2320],[2330,2840],[2850,3580],[3590,4820],[4830,5380],[5390,6340],[6350,9240]],"9":[[750,1920],[1930,2820],[2830,3470],[3480,4270],[4280,5910],[5920,6530],[6540,7630],[7640,8900]]}},{"k":10,"w":[["خَلَقَ","khalaqa"],["ٱلسَّمَـٰوَٰتِ","l-samaawaati"],["بِغَيْرِ","bighayri"],["عَمَدٍۢ","'amadin"],["تَرَوْنَهَا ۖ","tarawnahaa"],["وَأَلْقَىٰ","wa-alqaa"],["فِى","fee"],["ٱلْأَرْضِ","l-ardi"],["رَوَٰسِىَ","rawaasiya"],["أَن","an"],["تَمِيدَ","tameeda"],["بِكُمْ","bikum"],["وَبَثَّ","wabatha"],["فِيهَا","feehaa"],["مِن","min"],["كُلِّ","kulli"],["دَآبَّةٍۢ ۚ","daabbatin"],["وَأَنزَلْنَا","wa-anzalnaa"],["مِنَ","mina"],["ٱلسَّمَآءِ","l-samaai"],["مَآءًۭ","maaan"],["فَأَنۢبَتْنَا","fa-anbatnaa"],["فِيهَا","feehaa"],["مِن","min"],["كُلِّ","kulli"],["زَوْجٍۢ","zawjin"],["كَرِيمٍ","kareemin"]],"en":"He created the heavens without pillars that you see and has cast into the earth firmly set mountains, lest it should shift with you, and dispersed therein from every creature. And We sent down rain from the sky and made grow therein [plants] of every noble kind.","t":{"6":[[200,960],[970,3320],[3330,4570],[4580,6380],[6390,9400],[10400,11890],[11900,12290],[12300,13370],[13380,15470],[15480,16430],[16440,17750],[17760,18700],[18710,19990],[20000,21720],[21730,22810],[22820,23980],[23990,29000],[