{"n":113,"verses":[{"k":1,"w":[["قُلْ","qul"],["أَعُوذُ","a'oodhu"],["بِرَبِّ","birabbi"],["ٱلْفَلَقِ","l-falaq"]],"en":"Say, \"I seek refuge in the Lord of daybreak","t":{"6":[[600,1180],[1190,2510],[2520,4090],[4100,5330]],"12":[[200,650],[660,1880],[1890,3140],[3150,4130]],"7":[[30,340],[350,1200],[1210,2080],[2090,2870]],"9":[[350,780],[790,1730],[1740,2690],[2700,3810]]}},{"k":2,"w":[["مِن","min"],["شَرِّ","sharri"],["مَا","maa"],["خَلَقَ","khalaq"]],"en":"From the evil of that which He created","t":{"6":[[0,1360],[1370,2650],[2660,3410],[3420,4410]],"12":[[0,1180],[1190,2250],[2260,2850],[2860,3790]],"7":[[30,1300],[1310,2020],[2030,2370],[2380,3060]],"9":[[200,1150],[1160,1980],[1990,2400],[2410,3320]]}},{"k":3,"w":[["وَمِن","wamin"],["شَرِّ","sharri"],["غَاسِقٍ","ghaasiqin"],["إِذَا","idhaa"],["وَقَبَ","waqab"]],"en":"And from the evil of darkness when it settles","t":{"6":[[60,1320],[1330,2510],[2520,4620],[4630,5830],[5840,6740]],"12":[[300,1310],[1320,2210],[2220,3840],[3850,4870],[4880,5730]],"7":[[30,1410],[1420,2100],[2110,3190],[3200,3820],[3830,4470]],"9":[[200,1310],[1320,2120],[2130,3460],[3470,4230],[4240,5120]]}},{"k":4,"w":[["وَمِن","wamin"],["شَرِّ","sharri"],["ٱلنَّفَّـٰثَـٰتِ","l-nafaathaati"],["فِى","fee"],["ٱلْعُقَدِ","l-'uqad"]],"en":"And from the evil of the blowers in knots","t":{"6":[[410,1630],[1640,2860],[2870,6440],[6450,6860],[6870,8160]],"12":[[250,1210],[1220,2320],[2330,5030],[5040,5370],[5380,6420]],"7":[[30,1400],[1410,2140],[2150,4360],[4370,4590],[4600,5460]],"9":[[200,1380],[1390,2240],[2250,4750],[4760,5040],[5050,6180]]}},{"k":5,"w":[["وَمِن","wamin"],["شَرِّ","sharri"],["حَاسِدٍ","haasidin"],["إِذَا","idhaa"],["حَسَدَ","hasad"]],"en":"And from the evil of an envier when he envies.\"","t":{"6":[[340,1620],[1630,2670],[2680,4720],[4730,5890],[5900,6860]],"12":[[250,1230],[1240,2190],[2200,3670],[3680,4610],[4620,5550]],"7":[[30,1270],[1280,1920],[1930,3070],[3080,3640],[3650,4330]],"9":[[100,1200],[1210,1970],[1980,3390],[3