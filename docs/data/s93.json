{"n":93,"verses":[{"k":1,"w":[["وَٱلضُّحَىٰ","wal-duhaa"]],"en":"By the morning brightness","t":{"6":[[100,2250]],"12":[[250,2040]],"7":[[60,1610]],"9":[[100,1860]]}},{"k":2,"w":[["وَٱلَّيْلِ","wa-al-layli"],["إِذَا","idhaa"],["سَجَىٰ","sajaa"]],"en":"And [by] the night when it covers with darkness,","t":{"6":[[150,1520],[1530,2520],[2530,3800]],"12":[[250,1460],[1470,2480],[2490,3850]],"7":[[30,1040],[1050,1610],[1620,2690]],"9":[[240,1690],[1700,2460],[2470,3490]]}},{"k":3,"w":[["مَا","maa"],["وَدَّعَكَ","wadda'aka"],["رَبُّكَ","rabbuka"],["وَمَا","wamaa"],["قَلَىٰ","qalaa"]],"en":"Your Lord has not taken leave of you, [O Muhammad], nor has He detested [you].","t":{"6":[[60,660],[670,2370],[2380,3750],[3760,4710],[4720,5790]],"12":[[300,860],[870,2420],[2430,3670],[3680,4600],[4610,5790]],"7":[[70,490],[500,1520],[1530,2440],[2450,3050],[3060,3870]],"9":[[350,880],[890,2310],[2320,3570],[3580,4410],[4420,5490]]}},{"k":4,"w":[["وَلَلْـَٔاخِرَةُ","walalaakhiratu"],["خَيْرٌۭ","khayrun"],["لَّكَ","laka"],["مِنَ","mina"],["ٱلْأُولَىٰ","l-oolaa"]],"en":"And the Hereafter is better for you than the first [life].","t":{"6":[[100,2580],[2590,3730],[3740,4710],[4720,5340],[5350,7240]],"12":[[300,2620],[2630,3670],[3680,4580],[4590,5090],[5100,7050]],"7":[[30,1700],[1710,2430],[2440,3070],[3080,3450],[3460,4970]],"9":[[400,2740],[2750,3980],[3990,4580],[4590,5130],[5140,6790]]}},{"k":5,"w":[["وَلَسَوْفَ","walasawfa"],["يُعْطِيكَ","yu''teeka"],["رَبُّكَ","rabbuka"],["فَتَرْضَىٰٓ","fatardaa"]],"en":"And your Lord is going to give you, and you will be satisfied.","t":{"6":[[450,1950],[1960,3670],[3680,5160],[5170,7070]],"12":[[250,1690],[1700,3330],[3340,4540],[4550,6430]],"7":[[30,1060],[1070,2260],[2270,3110],[3120,4590]],"9":[[400,1850],[1860,3300],[3310,4540],[4550,5950]]}},{"k":6,"w":[["أَلَمْ","alam"],["يَجِدْكَ","yajid'ka"],["يَتِيمًۭا","yateeman"],["فَـَٔاوَىٰ","faaawaa"]],"en":"Did He not find you an orphan and give [you] refuge?","t":{"6":[[200,840],[850,2310],[2320,4430],[4440,6350]],"12":[[250,780],[790,2060],[2070,3990],[4000,6020]],"7":[[30,590],[600,1400],[1410,3360],[3370,4800]],"9":[[550,1280],[1290,2490],[2500,3740],[3750,6250]]}},{"k":7,"w":[["وَوَجَدَكَ","wawajadaka"],["ضَآلًّۭا","daallan"],["فَهَدَىٰ","fahadaa"]],"en":"And He found you lost and guided [you],","t":{"6":[[250,1740],[1750,6500],[6510,8030]],"12":[[350,1700],[1710,4970],[4980,9795]],"7":[[30,1010],[1020,5520],[5530,6840]],"9":[[350,4230],[4240,4760],[4770,6990]]}},{"k":8,"w":[["وَوَجَدَكَ","wawajadaka"],["عَآئِلًۭا","'aailan"],["فَأَغْنَىٰ","fa-aghnaa"]],"en":"And He found you poor and made [you] self-sufficient.","t":{"6":[[200,1660],[1670,4740],[4750,6760]],"12":[[250,1520],[1530,4510],[4520,6430]],"7":[[30,1040],[1050,4140],[4150,5600]],"9":[[250,1550],[1560,3900],[3910,6310]]}},{"k":9,"w":[["فَأَمَّا","fa-ammaa"],["ٱلْيَتِيمَ","l-yateema"],["فَلَا","falaa"],["تَقْهَرْ","taqhar"]],"en":"So as for the orphan, do not oppress [him].","t":{"6":[[600,1940],[1950,3730],[3740,4790],[4800,6280]],"12":[[450,1710],[1720,3270],[3280,4240],[4250,5630]],"7":[[30,1580],[1590,2720],[2730,3390],[3400,4290]],"9":[[400,1870],[1880,3400],[3410,4390],[4400,5580]]}},{"k":10,"w":[["وَأَمَّا","wa-ammaa"],["ٱلسَّآئِلَ","l-saaila"],["فَلَا","falaa"],["تَنْهَرْ","tanhar"]],"en":"And as for the petitioner, do not repel [him].","t":{"6":[[420,2250],[2260,5030],[5040,6210],[6220,7710]],"12":[[300,1760],[1770,4200],[4210,5230],[5240,6740]],"7":[[30,1280],[1290,4130],[4140,4780],[4790,5720]],"9":[[300,1740],[1750,4320],[4330,5200],[5210,6440]]}},{"k":11,"w":[["وَأَمَّا","wa-ammaa"],["بِنِعْمَةِ","bini''mati"],["رَبِّكَ","rabbika"],["فَحَدِّثْ","fahaddith"]],"en":"But as for the favor of your Lord, report [it].","t":{"6":[[60,2080],[2090,3840],[3850,5470],[5480,7130]],"12":[[450,2140],[2150,3580],[3590,4860],[4870,6320]],"7":[[30,1710],[1720,2790],[2800,3710],[3720,4960]],"9":[[250,2120],[2130,3550],[3560,4740],[4750,6100]]}}]}