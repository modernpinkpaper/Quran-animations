,["فَارِقُوهُنَّ","faariqoohunna"],["بِمَعْرُوفٍۢ","bima'roofin"],["وَأَشْهِدُوا۟","wa-ashhidoo"],["ذَوَىْ","dhaway"],["عَدْلٍۢ","'adlin"],["مِّنكُمْ","minkum"],["وَأَقِيمُوا۟","wa-aqeemoo"],["ٱلشَّهَـٰدَةَ","l-shahaadata"],["لِلَّهِ ۚ","lillahi"],["ذَٰلِكُمْ","dhaalikum"],["يُوعَظُ","yoo'azu"],["بِهِۦ","bihi"],["مَن","man"],["كَانَ","kaana"],["يُؤْمِنُ","yu'minu"],["بِٱللَّهِ","bil-lahi"],["وَٱلْيَوْمِ","wal-yawmi"],["ٱلْـَٔاخِرِ ۚ","l-aakhiri"],["وَمَن","waman"],["يَتَّقِ","yattaqi"],["ٱللَّهَ","l-laha"],["يَجْعَل","yaj'al"],["لَّهُۥ","lahu"],["مَخْرَجًۭا","makhrajan"]],"en":"And when they have [nearly] fulfilled their term, either retain them according to acceptable terms or part with them according to acceptable terms. And bring to witness two just men from among you and establish the testimony for [the acceptance of] Allah. That is instructed to whoever should believe in Allah and the Last day. And whoever fears Allah - He will make for him a way out","t":{"6":[[200,1120],[1130,2120],[2130,4150],[4160,7210],[7220,9170],[9180,9690],[9700,12550],[12560,15090],[15100,16700],[16710,17470],[17480,19190],[19200,21110],[21120,22600],[22610,24470],[24480,27300],[29650,31000],[31010,32300],[32310,33200],[33210,34260],[34270,35170],[35180,36260],[36270,37670],[37680,39090],[39100,41100],[42020,43350],[43360,44630],[44640,45770],[45780,46630],[46640,47900],[47910,49390]],"12":[[250,1060],[1070,2130],[2140,4180],[4190,7240],[7250,9290],[9300,9800],[9810,12660],[12670,14500],[18850,20320],[20330,21070],[21080,22580],[22590,24180],[24190,25500],[25510,27240],[27250,28750],[35400,36770],[36780,37960],[37970,38890],[38900,39840],[39850,40740],[40750,41800],[41810,43260],[43270,44630],[44640,46150],[50050,51160],[51170,52250],[52260,53330],[53340,54180],[54190,55230],[55240,56630]],"7":[[30,680],[690,1440],[1450,2970],[2980,5140],[5150,6440],[6450,6750],[6760,8800],[8810,10090],[10100,11900],[11910,12460],[12470,13870],[13880,15280],[15290,16180],[16190,17990],[18000,20050],[20