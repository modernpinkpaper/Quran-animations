{"n":108,"verses":[{"k":1,"w":[["إِنَّآ","innaa"],["أَعْطَيْنَـٰكَ","a'taynaaka"],["ٱلْكَوْثَرَ","l-kawthar"]],"en":"Indeed, We have granted you, [O Muhammad], al-Kawthar.","t":{"6":[[330,1540],[1550,5650],[5660,7460]],"12":[[40,2440],[2450,4720],[4730,6510]],"7":[[150,2120],[2130,4970],[4980,5900]],"9":[[150,1460],[1470,5080],[5090,6430]]}},{"k":2,"w":[["فَصَلِّ","fasalli"],["لِرَبِّكَ","lirabbika"],["وَٱنْحَرْ","wa-in'har"]],"en":"So pray to your Lord and sacrifice [to Him alone].","t":{"6":[[30,1330],[1340,3180],[3190,4720]],"12":[[30,1230],[1240,2780],[2790,4260]],"7":[[30,910],[920,1970],[1980,2790]],"9":[[300,1280],[1290,2560],[2570,3720]]}},{"k":3,"w":[["إِنَّ","inna"],["شَانِئَكَ","shaani-aka"],["هُوَ","huwa"],["ٱلْأَبْتَرُ","l-abtar"]],"en":"Indeed, your enemy is the one cut off.","t":{"6":[[30,1390],[1400,3220],[3230,4060],[4070,6010]],"12":[[200,1300],[1310,2930],[2940,3550],[3560,5320]],"7":[[30,1660],[1670,2750],[2760,3220],[3230,4250]],"9":[[150,1210],[1220,2590],[2600,3180],[3190,4530]]}}]}