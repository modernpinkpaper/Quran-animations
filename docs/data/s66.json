],[13300,14280],[14290,16140],[16150,17260],[17270,18690],[18700,19890],[19900,20480],[20490,22110],[22120,23750],[27980,29470],[29480,31700],[34450,37660],[37670,38490],[38500,39610],[39620,41240]],"7":[[120,1050],[1060,1790],[1800,4070],[4080,4850],[4860,5400],[5410,6010],[6020,8100],[8110,9310],[9320,10610],[10620,11310],[11320,12560],[12570,13300],[13310,13730],[13740,14730],[14740,15860],[15870,16890],[16900,19960],[19970,23010],[23020,23600],[23610,24370],[24380,26550]],"9":[[850,1680],[1690,3920],[3930,4350],[4360,5130],[5140,5730],[5740,6560],[6570,9110],[9120,10460],[10470,11810],[11820,12560],[12570,13900],[13910,14700],[14710,15170],[15180,16200],[16210,17490],[17500,18600],[18610,20450],[21650,24630],[24640,25220],[25230,26060],[26070,26970]]}},{"k":5,"w":[["عَسَىٰ","'asaa"],["رَبُّهُۥٓ","rabbuhu"],["إِن","in"],["طَلَّقَكُنَّ","tallaqakunna"],["أَن","an"],["يُبْدِلَهُۥٓ","yub'dilahu"],["أَزْوَٰجًا","azwaajan"],["خَيْرًۭا","khayran"],["مِّنكُنَّ","minkunna"],["مُسْلِمَـٰتٍۢ","mus'limaatin"],["مُّؤْمِنَـٰتٍۢ","mu'minaatin"],["قَـٰنِتَـٰتٍۢ","qaanitaatin"],["تَـٰٓئِبَـٰتٍ","taaibaatin"],["عَـٰبِدَٰتٍۢ","'aabidaatin"],["سَـٰٓئِحَـٰتٍۢ","saaihaatin"],["ثَيِّبَـٰتٍۢ","thayyibaatin"],["وَأَبْكَارًۭا","wa-abkaaran"]],"en":"Perhaps his Lord, if he divorced you [all], would substitute for him wives better than you - submitting [to Allah], believing, devoutly obedient, repentant, worshipping, and traveling - [ones] previously married and virgins.","t":{"6":[[450,1430],[1440,4210],[4220,5200],[5210,8340],[8350,9440],[9450,12330],[12340,14390],[14400,15630],[15640,19020],[19030,28290],[28300,31030],[31040,34290],[34300,37720],[37730,40950],[40960,44950],[44960,48050],[48060,50560]],"12":[[200,1060],[1070,2140],[2150,4590],[4600,7130],[7140,8240],[8250,10800],[10810,12550],[12560,13580],[13590,16780],[16790,26130],[26140,28710],[28720,31580],[31590,34730],[34740,36800],[42970,46730],[46740,49440],[49450,51520]],"7":[[110,770],[780,3230],[3240,3580],[3590,6410],[6420,7