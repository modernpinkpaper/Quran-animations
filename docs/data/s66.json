5270],[25280,26380],[26390,26740],[26750,27820],[27830,33390],[33400,33480],[33490,36310],[36320,37670],[37680,38070],[38080,40870]],"9":[[1250,3920],[3930,4990],[5000,5960],[5970,7760],[7770,9620],[9630,11060],[11070,11710],[11720,13510],[13520,14870],[14880,17300],[22050,23180],[23190,26090],[26100,27510],[27520,28480],[28490,28980],[28990,30080],[30090,30890],[30900,31990],[32000,34250],[40210,41700],[41710,42050],[42060,43330]]}},{"k":7,"w":[["يَـٰٓأَيُّهَا","yaaayyuhaa"],["ٱلَّذِينَ","alladheena"],["كَفَرُوا۟","kafaroo"],["لَا","laa"],["تَعْتَذِرُوا۟","ta'tadhiroo"],["ٱلْيَوْمَ ۖ","l-yawma"],["إِنَّمَا","innamaa"],["تُجْزَوْنَ","tuj'zawna"],["مَا","maa"],["كُنتُمْ","kuntum"],["تَعْمَلُونَ","ta'maloon"]],"en":"O you who have disbelieved, make no excuses that Day. You will only be recompensed for what you used to do.","t":{"6":[[2550,3860],[3870,5430],[5440,6940],[6950,7560],[7570,9420],[9430,11900],[12900,14880],[14890,16590],[16600,17300],[17310,19530],[19540,22730]],"12":[[350,2990],[3000,4420],[4430,5700],[5710,6230],[6240,7740],[7750,9150],[12600,14280],[14290,15730],[15740,16260],[16270,18100],[18110,19950]],"7":[[130,2840],[2850,3770],[3780,4670],[4680,4990],[5000,8070],[8080,8510],[8520,10100],[10110,11110],[11120,11480],[11490,13060],[13070,16390]],"9":[[950,3670],[3680,4650],[4660,5520],[5530,5860],[5870,7010],[7020,8700],[9150,10600],[10610,11730],[11740,12090],[12100,13570],[13580,14900]]}},{"k":8,"w":[["يَـٰٓأَيُّهَا","yaaayyuhaa"],["ٱلَّذِينَ","alladheena"],["ءَامَنُوا۟","aamanoo"],["تُوبُوٓا۟","tooboo"],["إِلَى","ilaa"],["ٱللَّهِ","l-lahi"],["تَوْبَةًۭ","tawbatan"],["نَّصُوحًا","nasoohan"],["عَسَىٰ","'asaa"],["رَبُّكُمْ","rabbukum"],["أَن","an"],["يُكَفِّرَ","yukaffira"],["عَنكُمْ","'ankum"],["سَيِّـَٔاتِكُمْ","sayyiaatikum"],["وَيُدْخِلَكُمْ","wayud'khilakum"],["جَنَّـٰتٍۢ","jannaatin"],["تَجْرِى","tajree"],["مِن","min"],["تَحْتِهَا","tahtihaa"],["ٱلْأَنْهَـٰرُ","l-anhaaru"],["يَوْمَ","yawma"],["لَا","laa"],["يُخْزِى","yukh'zee"],["ٱللَّهُ","l-lah