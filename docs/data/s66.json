{"n":66,"verses":[{"k":1,"w":[["يَـٰٓأَيُّهَا","yaaayyuhaa"],["ٱلنَّبِىُّ","l-nabiyu"],["لِمَ","lima"],["تُحَرِّمُ","tuharrimu"],["مَآ","maa"],["أَحَلَّ","ahalla"],["ٱللَّهُ","l-lahu"],["لَكَ ۖ","laka"],["تَبْتَغِى","tabtaghee"],["مَرْضَاتَ","mardaata"],["أَزْوَٰجِكَ ۚ","azwaajika"],["وَٱللَّهُ","wal-lahu"],["غَفُورٌۭ","ghafoorun"],["رَّحِيمٌۭ","raheemun"]],"en":"O Prophet, why do you prohibit [yourself from] what Allah has made lawful for you, seeking the approval of your wives? And Allah is Forgiving and Merciful.","t":{"6":[[550,3460],[3470,5520],[5530,6090],[6100,7890],[7900,9190],[9200,10520],[10530,11980],[11990,12580],[12590,14280],[14290,15830],[15840,18450],[19850,21560],[21570,23440],[23450,25630]],"12":[[300,3220],[3230,4880],[4890,5370],[5380,6840],[6850,8320],[8330,9400],[9410,10580],[10590,11100],[15340,16610],[16620,17730],[17740,19650],[22750,24070],[24080,25320],[25330,26910]],"7":[[70,2760],[2770,4400],[4410,4760],[4770,5760],[5770,6490],[6500,8580],[8590,9410],[9420,10330],[10340,11300],[11310,12080],[12090,13720],[13730,14680],[14690,15750],[15760,17940]],"9":[[1350,4330],[4340,5720],[5730,6070],[6080,7230],[7240,8540],[8550,9560],[9570,10370],[10380,10580],[10590,11950],[11960,12730],[12740,14850],[15400,16390],[16400,17410],[17420,18280]]}},{"k":2,"w":[["قَدْ","qad"],["فَرَضَ","farada"],["ٱللَّهُ","l-lahu"],["لَكُمْ","lakum"],["تَحِلَّةَ","tahillata"],["أَيْمَـٰنِكُمْ ۚ","aymaanikum"],["وَٱللَّهُ","wal-lahu"],["مَوْلَىٰكُمْ ۖ","mawlaakum"],["وَهُوَ","wahuwa"],["ٱلْعَلِيمُ","l-'aleemu"],["ٱلْحَكِيمُ","l-hakeem"]],"en":"Allah has already ordained for you [Muslims] the dissolution of your oaths. And Allah is your protector, and He is the Knowing, the Wise.","t":{"6":[[450,890],[900,1950],[1960,3480],[3490,4390],[4400,6320],[6330,9150],[10450,12040],[12050,14750],[15900,16810],[16820,18720],[18730,21160]],"12":[[250,580],[590,1380],[1390,2530],[2540,3390],[3400,4710],[4720,6800],[10050,11400],[11410,13200],[15950,16530],[16540,17900],[17910,19520]],"7":[[70,330],[340,950],[960,1760],[1770,2300],[2310,3330],[3340,5170],[5180,6140],[6150,7730],[7740,8310],[8320,9270],[9280,11750]],"9":[[650,960],[970,1550],[1560,2370],[2380,2940],[2950,4050],[4060,6050],[6350,7330],[7340,9100],[9300,9880],[9890,10910],[10920,11980]]}},{"k":3,"w":[["وَإِذْ","wa-idh"],["أَسَرَّ","asarra"],["ٱلنَّبِىُّ","l-nabiyu"],["إِلَىٰ","ilaa"],["بَعْضِ","ba'di"],["أَزْوَٰجِهِۦ","azwaajihi"],["حَدِيثًۭا","hadeethan"],["فَلَمَّا","falammaa"],["نَبَّأَتْ","nabba-at"],["بِهِۦ","bihi"],["وَأَظْهَرَهُ","wa-azharahu"],["ٱللَّهُ","l-lahu"],["عَلَيْهِ","'alayhi"],["عَرَّفَ","'arrafa"],["بَعْضَهُۥ","ba'dahu"],["وَأَعْرَضَ","wa-a'rada"],["عَنۢ","'an"],["بَعْضٍۢ ۖ","ba'din"],["فَلَمَّا","falammaa"],["نَبَّأَهَا","nabba-ahaa"],["بِهِۦ","bihi"],["قَالَتْ","qaalat"],["مَنْ","man"],["أَنۢبَأَكَ","anba-aka"],["هَـٰذَا ۖ","haadhaa"],["قَالَ","qaala"],["نَبَّأَنِىَ","nabba-aniya"],["ٱلْعَلِيمُ","l-'aleemu"],["ٱلْخَبِيرُ","l-khabeer"]],"en":"And [remember] when the Prophet confided to one of his wives a statement; and when she informed [another] of it and Allah showed it to him, he made known part of it and ignored a part. And when he informed her about it, she said, \"Who told you this?\" He said, \"I was informed by the Knowing, the Acquainted.\"","t":{"6":[[110,720],[730,1980],[1990,3750],[3760,4670],[4680,5590],[5600,7720],[7730,9750],[9760,11780],[11790,13360],[13370,14420],[14430,16430],[16440,17500],[17510,18820],[18830,20170],[20180,22010],[22020,23530],[23540,24740],[24750,26050],[28800,30580],[30590,32690],[32700,33650],[33660,35140],[35150,35910],[35920,38130],[38140,40250],[41250,42240],[42250,44230],[44240,46220],[46230,49130]],"12":[[250,860],[870,2180],[2190,3730],[3740,4570],[4580,5380],[5390,7380],[7390,9400],[9410,11500],[16730,18100],[18110,19100],[19110,20790],[20800,21940],[21950,23150],[23160,24420],[24430,25600],[33120,34460],[34470,35590],[35600,36500],[40550,42150],[42160,43860],[43870,44760],[44770,46050],[46150,46760],[46770,48670],[