َا","lamasnaa"],["ٱلسَّمَآءَ","l-samaaa"],["فَوَجَدْنَـٰهَا","fawajadnaahaa"],["مُلِئَتْ","muli-at"],["حَرَسًۭا","harasan"],["شَدِيدًۭا","shadeedan"],["وَشُهُبًۭا","washuhuban"]],"en":"And we have sought [to reach] the heaven but found it filled with powerful guards and burning flames.","t":{"6":[[500,2570],[2580,3870],[3880,6200],[6210,8930],[8940,9980],[9990,11780],[11790,13230],[13240,15570]],"12":[[200,1880],[1890,2930],[2940,5400],[5410,7820],[7830,8820],[8830,10420],[10430,11660],[11670,13610]],"7":[[30,1480],[1490,2190],[2200,4510],[4520,6050],[6060,6720],[6730,8170],[8180,8990],[9000,11110]],"9":[[450,1890],[1900,2750],[2760,5100],[5110,7080],[7090,8080],[8090,9470],[9480,10560],[10570,12280]]}},{"k":9,"w":[["وَأَنَّا","wa-annaa"],["كُنَّا","kunnaa"],["نَقْعُدُ","naq'udu"],["مِنْهَا","min'haa"],["مَقَـٰعِدَ","maqaa'ida"],["لِلسَّمْعِ ۖ","lilssam'i"],["فَمَن","faman"],["يَسْتَمِعِ","yastami'i"],["ٱلْـَٔانَ","l-aana"],["يَجِدْ","yajid"],["لَهُۥ","lahu"],["شِهَابًۭا","shihaaban"],["رَّصَدًۭا","rasadan"]],"en":"And we used to sit therein in positions for hearing, but whoever listens now will find a burning flame lying in wait for him.","t":{"6":[[870,2890],[2900,4780],[4790,6010],[6020,7310],[7320,9090],[9100,11150],[12350,13670],[13680,15210],[15220,16370],[16380,17280],[17290,18220],[18230,19590],[19600,21180]],"12":[[150,1820],[1830,3530],[3540,4600],[4610,5850],[5860,7250],[7260,8550],[13050,14130],[14140,15360],[15370,16470],[16480,17330],[17340,18110],[18120,19280],[19290,20430]],"7":[[30,1540],[1550,2930],[2940,3700],[3710,4430],[4440,5470],[5480,6810],[6820,8150],[8160,8910],[8920,9610],[9620,10240],[10250,10820],[10830,11570],[11580,12800]],"9":[[650,2100],[2110,3590],[3600,4560],[4570,5620],[5630,6930],[6940,8790],[8800,10130],[10140,11180],[11190,12080],[12090,12730],[12740,13520],[13530,14560],[14570,15810]]}},{"k":10,"w":[["وَأَنَّا","wa-annaa"],["لَا","laa"],["نَدْرِىٓ","nadree"],["أَشَرٌّ","asharrun"],["أُرِيدَ","ureeda"],["بِمَن","biman"],["فِى"