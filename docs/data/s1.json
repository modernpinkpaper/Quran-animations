{"n":1,"verses":[{"k":1,"w":[["بِسْمِ","bis'mi"],["ٱللَّهِ","l-lahi"],["ٱلرَّحْمَـٰنِ","l-rahmaani"],["ٱلرَّحِيمِ","l-raheem"]],"en":"In the name of Allah, the Entirely Merciful, the Especially Merciful.","t":{"6":[[50,510],[520,1180],[1190,2340],[2350,4480]],"12":[[0,820],[830,1520],[1530,2790],[2800,4240]],"7":[[60,610],[620,1310],[1320,2450],[2460,5970]],"9":[[600,930],[940,1630],[1640,2730],[2740,4170]]}},{"k":2,"w":[["ٱلْحَمْدُ","al-hamdu"],["لِلَّهِ","lillahi"],["رَبِّ","rabbi"],["ٱلْعَـٰلَمِينَ","l-'aalameen"]],"en":"[All] praise is [due] to Allah, Lord of the worlds -","t":{"6":[[700,1410],[1420,2200],[2210,2880],[2890,5310]],"12":[[250,1060],[1070,1950],[1960,2660],[2670,4360]],"7":[[80,960],[970,1800],[1810,2460],[2470,5140]],"9":[[800,1710],[1720,2630],[2640,3290],[3300,4890]]}},{"k":3,"w":[["ٱلرَّحْمَـٰنِ","al-rahmaani"],["ٱلرَّحِيمِ","l-raheem"]],"en":"The Entirely Merciful, the Especially Merciful,","t":{"6":[[150,1400],[1410,3530]],"12":[[250,1570],[1580,2990]],"7":[[40,1230],[1240,4160]],"9":[[800,2080],[2090,3700]]}},{"k":4,"w":[["مَـٰلِكِ","maaliki"],["يَوْمِ","yawmi"],["ٱلدِّينِ","l-deen"]],"en":"Sovereign of the Day of Recompense.","t":{"6":[[0,1040],[1050,1660],[1670,3630]],"12":[[250,1160],[1170,1800],[1810,2980]],"7":[[60,840],[850,1400],[1410,4280]],"9":[[0,1720],[1730,2320],[2330,3570]]}},{"k":5,"w":[["إِيَّاكَ","iyyaaka"],["نَعْبُدُ","na'budu"],["وَإِيَّاكَ","wa-iyyaaka"],["نَسْتَعِينُ","nasta'een"]],"en":"It is You we worship and You we ask for help.","t":{"6":[[350,1310],[1320,2210],[2220,3510],[3520,5900]],"12":[[250,1380],[1390,2320],[2330,3820],[3830,5430]],"7":[[30,970],[980,1710],[1720,2870],[2880,6290]],"9":[[1000,2040],[2050,2860],[2870,4120],[4130,5570]]}},{"k":6,"w":[["ٱهْدِنَا","ih'dinaa"],["ٱلصِّرَٰطَ","l-siraata"],["ٱلْمُسْتَقِيمَ","l-mus'taqeem"]],"en":"Guide us to the straight path -","t":{"6":[[300,870],[880,1790],[1800,4480]],"12":[[50,780],[790,1940],[1950,3940]],"7":[[30,670],[680,1630],[1640,5120]],"9":[[900,1490],[1500