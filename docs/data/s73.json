{"n":73,"verses":[{"k":1,"w":[["يَـٰٓأَيُّهَا","yaaayyuhaa"],["ٱلْمُزَّمِّلُ","l-muzamil"]],"en":"O you who wraps himself [in clothing],","t":{"6":[[900,3740],[3750,5180]],"12":[[150,2890],[2900,5270]],"7":[[50,2800],[2810,4990]],"9":[[300,3290],[3300,5360]]}},{"k":2,"w":[["قُمِ","qumi"],["ٱلَّيْلَ","al-layla"],["إِلَّا","illaa"],["قَلِيلًۭا","qaleelan"]],"en":"Arise [to pray] the night, except for a little -","t":{"6":[[250,670],[680,1830],[1840,2990],[3000,4210]],"12":[[200,580],[590,1580],[1590,2680],[2690,4190]],"7":[[30,420],[430,1130],[1140,1890],[1900,2870]],"9":[[210,660],[670,1530],[1540,2400],[2410,3610]]}},{"k":3,"w":[["نِّصْفَهُۥٓ","nis'fahu"],["أَوِ","awi"],["ٱنقُصْ","unqus"],["مِنْهُ","min'hu"],["قَلِيلًا","qaleelan"]],"en":"Half of it - or subtract from it a little","t":{"6":[[100,2530],[2540,3210],[3220,4540],[4550,5500],[5510,7010]],"12":[[150,1930],[0,0],[1940,4460],[4470,5340],[5350,7100]],"7":[[90,2270],[2280,2690],[2700,3820],[3830,4350],[4360,5530]],"9":[[470,2760],[2770,3120],[3130,4520],[4530,5200],[5210,6440]]}},{"k":4,"w":[["أَوْ","aw"],["زِدْ","zid"],["عَلَيْهِ","'alayhi"],["وَرَتِّلِ","warattili"],["ٱلْقُرْءَانَ","l-qur'aana"],["تَرْتِيلًا","tarteelan"]],"en":"Or add to it, and recite the Qur'an with measured recitation.","t":{"6":[[700,1100],[1110,1550],[1560,2980],[2990,4560],[4570,6450],[6460,8370]],"12":[[30,310],[320,760],[770,2030],[2040,3480],[3490,5240],[5250,6740]],"7":[[90,400],[410,770],[780,1690],[1700,2650],[2660,3780],[3790,5200]],"9":[[260,640],[650,1020],[1030,2690],[2700,3850],[3860,5210],[5220,6580]]}},{"k":5,"w":[["إِنَّا","innaa"],["سَنُلْقِى","sanul'qee"],["عَلَيْكَ","'alayka"],["قَوْلًۭا","qawlan"],["ثَقِيلًا","thaqeelan"]],"en":"Indeed, We will cast upon you a heavy word.","t":{"6":[[1400,3110],[3120,4890],[4900,6250],[6260,7980],[7990,9670]],"12":[[250,1740],[1750,3220],[3230,4390],[4400,5910],[5920,7480]],"7":[[30,1450],[1460,2400],[2410,3270],[3280,4580],[4590,5900]],"9":[[450,1760],[1770,2950],[2960,3940],[3950,5400],[5410,6550]]}},{"k":6,"w":[["إِنَّ","inna"],["نَاشِئَةَ","naashi-ata"],["ٱلَّيْلِ","al-layli"],["هِىَ","hiya"],["أَشَدُّ","ashaddu"],["وَطْـًۭٔا","watan"],["وَأَقْوَمُ","wa-aqwamu"],["قِيلًا","qeelan"]],"en":"Indeed, the hours of the night are more effective for concurrence [of heart and tongue] and more suitable for words.","t":{"6":[[550,1780],[1790,3400],[3410,4660],[4670,5280],[5290,6550],[6560,7560],[7570,9880],[9890,11130]],"12":[[250,1450],[1460,2790],[2800,3970],[3980,4530],[4540,5740],[5750,6240],[6250,8640],[8650,9830]],"7":[[30,1050],[1060,1960],[1970,2730],[2740,3100],[3110,3890],[3900,4450],[4460,6100],[6110,7060]],"9":[[400,1640],[1650,2740],[2750,3690],[3700,4150],[4160,5080],[5090,5580],[5590,7870],[7880,8860]]}},{"k":7,"w":[["إِنَّ","inna"],["لَكَ","laka"],["فِى","fee"],["ٱلنَّهَارِ","l-nahaari"],["سَبْحًۭا","sabhan"],["طَوِيلًۭا","taweelan"]],"en":"Indeed, for you by day is prolonged occupation.","t":{"6":[[250,1620],[1630,2220],[2230,2620],[2630,4460],[4470,6050],[6060,7520]],"12":[[50,1370],[1380,1880],[1890,2240],[2250,3990],[4000,5490],[5500,7030]],"7":[[30,980],[990,1340],[1350,1600],[1610,3220],[3230,3940],[3950,5830]],"9":[[450,1480],[1490,1900],[1910,2100],[2110,3680],[3690,5060],[5070,6260]]}},{"k":8,"w":[["وَٱذْكُرِ","wa-udh'kuri"],["ٱسْمَ","is'ma"],["رَبِّكَ","rabbika"],["وَتَبَتَّلْ","watabattal"],["إِلَيْهِ","ilayhi"],["تَبْتِيلًۭا","tabteelan"]],"en":"And remember the name of your Lord and devote yourself to Him with [complete] devotion.","t":{"6":[[350,1330],[1340,1930],[1940,3280],[3290,5210],[5220,6380],[6390,8170]],"12":[[150,1110],[1120,1640],[1650,2940],[2950,4740],[4750,5940],[5950,7470]],"7":[[40,730],[740,1180],[1190,1970],[1980,3150],[3160,3830],[3840,5170]],"9":[[370,1220],[1230,1700],[1710,2740],[2750,4170],[4180,5050],[5060,6400]]}},{"k":9,"w":[["رَّبُّ","rabbu"],["ٱلْمَشْرِقِ","l-mashriqi"],["وَٱلْمَغْرِبِ","wal-maghribi"],["لَآ","laa"],["إِلَـٰهَ","ilaaha"],["إِلَّا","illaa"],["هُوَ","huwa"],["فَٱتَّخِذْهُ","fa-i