{"n":95,"verses":[{"k":1,"w":[["وَٱلتِّينِ","wal-teeni"],["وَٱلزَّيْتُونِ","wal-zaytoon"]],"en":"By the fig and the olive","t":{"6":[[150,1720],[1730,4930]],"12":[[300,1840],[1850,3980]],"7":[[30,1040],[1050,4050]],"9":[[350,1570],[1580,3440]]}},{"k":2,"w":[["وَطُورِ","watoori"],["سِينِينَ","seeneen"]],"en":"And [by] Mount Sinai","t":{"6":[[150,1420],[1430,3860]],"12":[[150,1350],[1360,5198]],"7":[[30,820],[830,3330]],"9":[[250,1220],[1230,2580]]}},{"k":3,"w":[["وَهَـٰذَا","wahaadhaa"],["ٱلْبَلَدِ","l-baladi"],["ٱلْأَمِينِ","l-ameen"]],"en":"And [by] this secure city [Makkah],","t":{"6":[[100,1440],[1450,2830],[2840,5210]],"12":[[250,1240],[1250,2490],[2500,4080]],"7":[[30,800],[810,1640],[1650,4420]],"9":[[200,1240],[1250,2400],[2410,3640]]}},{"k":4,"w":[["لَقَدْ","laqad"],["خَلَقْنَا","khalaqnaa"],["ٱلْإِنسَـٰنَ","l-insaana"],["فِىٓ","fee"],["أَحْسَنِ","ahsani"],["تَقْوِيمٍۢ","taqweemin"]],"en":"We have certainly created man in the best of stature;","t":{"6":[[350,1090],[1100,2610],[2620,5290],[5300,7060],[7070,8420],[8430,10800]],"12":[[200,670],[680,1870],[1880,4180],[4190,5730],[5740,6940],[6950,8570]],"7":[[50,530],[540,1350],[1360,3280],[3290,4980],[4990,5720],[5730,8120]],"9":[[300,980],[990,2170],[2180,4350],[4360,6020],[6030,7140],[7150,8660]]}},{"k":5,"w":[["ثُمَّ","thumma"],["رَدَدْنَـٰهُ","radadnaahu"],["أَسْفَلَ","asfala"],["سَـٰفِلِينَ","saafileen"]],"en":"Then We return him to the lowest of the low,","t":{"6":[[800,1920],[1930,4110],[4120,5440],[5450,8280]],"12":[[350,1390],[1400,3210],[3220,4340],[4350,6270]],"7":[[30,1310],[1320,2540],[2550,3290],[3300,6350]],"9":[[450,1730],[1740,3480],[3490,4590],[4600,6340]]}},{"k":6,"w":[["إِلَّا","illaa"],["ٱلَّذِينَ","alladheena"],["ءَامَنُوا۟","aamanoo"],["وَعَمِلُوا۟","wa'amiloo"],["ٱلصَّـٰلِحَـٰتِ","l-saalihaati"],["فَلَهُمْ","falahum"],["أَجْرٌ","ajrun"],["غَيْرُ","ghayru"],["مَمْنُونٍۢ","mamnoonin"]],"en":"Except for those who believe and do righteous deeds, for they will have a reward uninterrupted.","t