{"n":112,"verses":[{"k":1,"w":[["قُلْ","qul"],["هُوَ","huwa"],["ٱللَّهُ","l-lahu"],["أَحَدٌ","ahadun"]],"en":"Say, \"He is Allah, [who is] One,","t":{"6":[[850,1370],[1380,2090],[2100,3710],[3720,4610]],"12":[[150,710],[720,1170],[1180,2450],[2460,3150]],"7":[[30,390],[400,790],[800,1640],[1650,2300]],"9":[[150,520],[530,1000],[1010,1970],[1980,2900]]}},{"k":2,"w":[["ٱللَّهُ","al-lahu"],["ٱلصَّمَدُ","l-samad"]],"en":"Allah, the Eternal Refuge.","t":{"6":[[1610,2580],[2590,3760]],"12":[[0,1580],[1590,3010]],"7":[[40,980],[990,1850]],"9":[[250,1340],[1350,2420]]}},{"k":3,"w":[["لَمْ","lam"],["يَلِدْ","yalid"],["وَلَمْ","walam"],["يُولَدْ","yoolad"]],"en":"He neither begets nor is born,","t":{"6":[[450,910],[920,2080],[2090,3380],[3390,4900]],"12":[[250,630],[640,1640],[1650,2490],[2500,3580]],"7":[[60,390],[400,1000],[1010,1720],[1730,2490]],"9":[[250,720],[730,1310],[1320,1970],[1980,3150]]}},{"k":4,"w":[["وَلَمْ","walam"],["يَكُن","yakun"],["لَّهُۥ","lahu"],["كُفُوًا","kufuwan"],["أَحَدٌۢ","ahadun"]],"en":"Nor is there to Him any equivalent.\"","t":{"6":[[200,1140],[1150,1970],[1980,3600],[3610,5280],[5290,6150]],"12":[[150,750],[760,1480],[1490,2710],[2720,3980],[3990,4790]],"7":[[30,650],[660,1130],[1140,2040],[2050,2950],[2960,3570]],"9":[[350,1020],[1030,1560],[1570,2560],[2570,3700],[3710,4540]]}}]}