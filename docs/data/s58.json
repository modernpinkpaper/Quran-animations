لِّ","bikulli"],["شَىْءٍ","shayin"],["عَلِيمٌ","'aleemun"]],"en":"Have you not considered that Allah knows what is in the heavens and what is on the earth? There is in no private conversation three but that He is the fourth of them, nor are there five but that He is the sixth of them - and no less than that and no more except that He is with them [in knowledge] wherever they are. Then He will inform them of what they did, on the Day of Resurrection. Indeed Allah is, of all things, Knowing.","t":{"6":[[850,1450],[1460,2280],[2290,3580],[3590,4910],[4920,6250],[6260,6830],[6840,7200],[7210,9650],[9660,10780],[10790,11210],[11220,12800],[14600,15250],[15260,16740],[16750,17060],[17070,19160],[19170,21320],[21330,22570],[22580,23250],[23260,25170],[25180,26130],[26140,28000],[28010,29350],[29360,30030],[30040,32250],[32260,33700],[33710,35710],[35720,36730],[36740,38230],[38240,40010],[40020,41480],[41490,42890],[42900,43730],[43740,45650],[59920,60840],[60850,61540],[61550,63030],[63040,64450],[64460,67290],[67300,68120],[68130,69780],[69790,70920],[70930,73750],[76900,78460],[78470,79820],[79830,81190],[81200,82730],[82740,84800]],"12":[[300,830],[840,1330],[1340,2470],[2480,3550],[3560,4380],[4390,5160],[5170,5430],[5440,7450],[7460,8330],[8340,8660],[8670,9800],[16400,16880],[16890,18010],[18020,18310],[18320,19920],[19930,21730],[21740,22820],[22830,23390],[23400,25170],[25180,25960],[25970,27250],[35220,36290],[36300,36850],[36860,38600],[38610,45740],[45750,46880],[46890,47790],[47800,48960],[48970,50790],[50800,51910],[51920,52980],[52990,53600],[53610,54760],[54770,55580],[55590,56120],[56130,57500],[63500,64510],[64520,66940],[66950,67650],[67660,68800],[68810,69550],[69560,71300],[76900,78010],[78020,79100],[79110,80160],[80170,81220],[81230,82510]],"7":[[30,530],[540,980],[990,2260],[2270,3060],[3070,3880],[3890,4220],[4230,4440],[4450,5900],[5910,6440],[6450,6690],[6700,7930],[7940,8250],[8260,9100],[9110,10160],[10170,10830],[10840,12110],[12120,12860],[12