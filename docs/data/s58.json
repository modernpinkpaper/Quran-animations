{"n":58,"verses":[{"k":1,"w":[["قَدْ","qad"],["سَمِعَ","sami'a"],["ٱللَّهُ","l-lahu"],["قَوْلَ","qawla"],["ٱلَّتِى","allatee"],["تُجَـٰدِلُكَ","tujaadiluka"],["فِى","fee"],["زَوْجِهَا","zawjihaa"],["وَتَشْتَكِىٓ","watashtakee"],["إِلَى","ilaa"],["ٱللَّهِ","l-lahi"],["وَٱللَّهُ","wal-lahu"],["يَسْمَعُ","yasma'u"],["تَحَاوُرَكُمَآ ۚ","tahaawurakumaa"],["إِنَّ","inna"],["ٱللَّهَ","l-laha"],["سَمِيعٌۢ","samee'un"],["بَصِيرٌ","baseerun"]],"en":"Certainly has Allah heard the speech of the one who argues with you, [O Muhammad], concerning her husband and directs her complaint to Allah. And Allah hears your dialogue; indeed, Allah is Hearing and Seeing.","t":{"6":[[400,680],[690,1730],[1740,2970],[2980,3860],[3870,5080],[5090,6930],[6940,7630],[7640,9350],[9360,12540],[12550,13080],[13090,14600],[14610,16310],[16320,17660],[17670,21250],[23250,24830],[24840,26100],[26110,28650],[28660,30750]],"12":[[250,520],[530,1290],[1300,2360],[2370,3020],[3030,4060],[4070,5550],[5560,6070],[6080,7270],[7280,9710],[9720,10090],[10100,11350],[20070,21320],[21330,22280],[22290,24750],[30000,31070],[31080,32060],[32070,33900],[33910,35420]],"7":[[70,360],[370,1010],[1020,1710],[1720,2250],[2260,2960],[2970,4060],[4070,4400],[4410,5390],[5400,7610],[7620,7930],[7940,8710],[8720,9640],[9650,10430],[10440,12530],[12540,13790],[13800,14550],[14560,16220],[16230,18230]],"9":[[300,500],[510,1170],[1180,1920],[1930,2520],[2530,3280],[3290,4520],[4530,4940],[4950,6020],[6030,13050],[13060,13390],[13400,14220],[14230,15170],[15180,16030],[16040,18450],[18460,19520],[19530,20310],[20320,21970],[21980,22910]]}},{"k":2,"w":[["ٱلَّذِينَ","alladheena"],["يُظَـٰهِرُونَ","yuzaahiroona"],["مِنكُم","minkum"],["مِّن","min"],["نِّسَآئِهِم","nisaaihim"],["مَّا","maa"],["هُنَّ","hunna"],["أُمَّهَـٰتِهِمْ ۖ","ummahaatihim"],["إِنْ","in"],["أُمَّهَـٰتُهُمْ","ummahaatuhum"],["إِلَّا","illaa"],["ٱلَّـٰٓـِٔى","allaaee"],["وَلَدْنَهُمْ ۚ","waladnahum"],["وَإِنَّهُمْ","wa-innahum"],["لَيَقُولُونَ","layaqooloona"],["مُنكَرًۭا","munkaran"],["مِّنَ","mina"],["ٱلْقَوْلِ","l-qawli"],["وَزُورًۭا ۚ","wazooran"],["وَإِنَّ","wa-inna"],["ٱللَّهَ","l-laha"],["لَعَفُوٌّ","la'afuwwun"],["غَفُورٌۭ","ghafoorun"]],"en":"Those who pronounce thihar among you [to separate] from their wives - they are not [consequently] their mothers. Their mothers are none but those who gave birth to them. And indeed, they are saying an objectionable statement and a falsehood. But indeed, Allah is Pardoning and Forgiving.","t":{"6":[[300,1690],[1700,4000],[4010,6210],[6220,6480],[6490,10280],[10290,11050],[11060,13550],[13560,15900],[18600,20430],[20440,22230],[22240,23290],[23300,26170],[26180,28600],[30350,32360],[32370,34770],[34780,37170],[37180,37710],[37720,39210],[39220,41900],[43250,45150],[45160,46560],[46570,48740],[48750,51280]],"12":[[200,1520],[1530,3430],[3440,5500],[5510,6500],[6510,9380],[9390,9860],[9870,11050],[11060,13550],[18700,19110],[19120,21560],[21570,22260],[22270,24710],[24720,26250],[32500,34140],[34150,35890],[35900,37990],[38000,38360],[38370,39410],[39420,40950],[44650,45880],[45890,46980],[46990,48420],[48430,49780]],"7":[[40,1030],[1040,2370],[2380,4640],[4650,5480],[5490,8270],[8280,8540],[8550,9910],[9920,12530],[12540,12880],[12890,15250],[15260,15760],[15770,18160],[18170,19920],[19930,21620],[21630,22980],[22990,25160],[25170,25400],[25410,26220],[26230,27770],[27780,29180],[29190,30010],[30020,31120],[31130,33070]],"9":[[300,1360],[1370,2810],[2820,4580],[4590,5470],[5480,8230],[8240,8600],[8610,9610],[9620,12450],[12600,12950],[12960,14950],[14960,15490],[15500,17880],[17890,19870],[19880,21420],[21430,22880],[22890,24140],[24150,25120],[25130,25970],[25980,27590],[27600,28850],[28860,29730],[29740,30990],[31000,31850]]}},{"k":3,"w":[["وَٱلَّذِينَ","wa-alladheena"],["يُظَـٰهِرُونَ","yuzaahiroona"],["مِن","min"],["نِّسَآئِهِمْ","nisaaihim"],["ثُمَّ","thumma"],["يَعُودُونَ","ya'oodoona"],["لِمَا","limaa"],["قَالُوا۟","qaaloo"],["فَتَحْرِيرُ","fatahreeru"],["رَقَبَةٍۢ","raqabatin"],["مِّن","min"],["قَبْلِ","qabli"],["أَن","an"],["يَتَمَآسَّا ۚ","yatamaassaa"],["ذَٰلِكُمْ","dhaalikum"],["تُوعَظُونَ","too'azoona"],["بِهِۦ ۚ","bihi"],["وَٱللَّهُ","wal-lahu"],["بِمَا","bimaa"],["تَعْمَلُونَ","ta'maloona"],["خَبِيرٌۭ","khabeerun"]],"en":"And those who pronounce thihar from their wives and then [wish to] go back on what they said - then [there must be] the freeing of a slave before they touch one another. That is what you are admonished thereby; and Allah is Acquainted with what you do.","t":{"6":[[550,2200],[2210,4670],[4680,4940],[4950,8420],[8430,9820],[9830,11840],[11850,12740],[12750,14160],[14170,16250],[16260,18490],[18500,19470],[19480,20610],[20620,21780],[21790,27350],[30750,32430],[32440,34660],[34670,36050],[37400,38850],[38860,39830],[39840,41820],[41830,43990]],"12":[[300,1620],[1630,3490],[3500,4380],[4390,6780],[6790,7920],[7930,9550],[9560,10350],[10360,11580],[11590,13260],[13270,23480],[23490,24420],[24430,25200],[25210,26180],[26190,30400],[36600,37880],[37890,39390],[39400,39900],[43550,44710],[44720,45470],[45480,46990],[47000,48330]],"7":[[100,1140],[1150,2480],[2490,3440],[3450,5940],[5950,7060],[7070,8250],[8260,8770],[8780,9500],[9510,10680],[10690,14500],[14510,15450],[15460,16100],[16110,17450],[17460,21960],[21970,22950],[22960,24220],[24230,25000],[25010,25980],[25990,26530],[26540,27700],[27710,29860]],"9":[[350,1430],[1440,2900],[2910,3790],[3800,5860],[5870,6920],[6930,8220],[8230,8800],[8810,10700],[14410,15730],[15740,17380],[17390,18140],[18150,18880],[18890,19730],[19740,24010],[24020,25060],[25070,26410],[26420,27360],[27370,28390],[28400,28980],[28990,30250],[30260,31130]]}},{"k":4,"w":[["فَمَن","faman"],["لَّمْ","lam"],["يَجِدْ","yajid"],["فَصِيَامُ","fasiyaamu"],["شَهْرَيْنِ","shahrayni"],["مُتَتَابِعَيْنِ","mutataabi'ayni"],["مِن","min"],["قَبْلِ","qabli"],["أَن","an"],["يَتَمَآسَّا ۖ","yatamaassaa"],["فَمَن","faman"],["لَّمْ","lam"],["يَسْتَطِعْ","yastati'"],["فَإِطْعَامُ","fa-it''aamu"],["سِتِّينَ","sitteena"],["مِسْكِينًۭا ۚ","mis'keenan"],["ذَٰلِكَ","dhaalika"],["لِتُؤْمِنُوا۟","litu'minoo"],["بِٱللَّهِ","bil-lahi"],["وَرَسُولِهِۦ ۚ","warasoolihi"],["وَتِلْكَ","watil'ka"],["حُدُودُ","hudoodu"],["ٱللَّهِ ۗ","l-lahi"],["وَلِلْكَـٰفِرِينَ","walil'kaafireena"],["عَذَابٌ","'adhaabun"],["أَلِيمٌ","aleemun"]],"en":"And he who does not find [a slave] - then a fast for two months consecutively before they touch one another; and he who is unable - then the feeding of sixty poor persons. That is for you to believe [completely] in Allah and His Messenger; and those are the limits [set by] Allah. And for the disbelievers is a painful punishment.","t":{"6":[[1000,1380],[1390,2290],[2300,3220],[3230,4900],[4910,6650],[6660,9250],[9260,10200],[10210,11240],[11250,12480],[12490,18000],[20700,21090],[21100,21940],[21950,23560],[23570,25600],[25610,27350],[27360,30100],[31350,32600],[32610,34610],[34620,36170],[36180,38600],[39820,41030],[41040,42990],[43000,45450],[46100,48730],[48740,50750],[50760,52890]],"12":[[500,720],[730,1450],[1460,2220],[2230,3580],[3590,4870],[4880,7070],[7080,7990],[8000,8760],[8770,9760],[9770,13700],[20450,20690],[20700,21450],[21460,22750],[22760,24380],[24390,25740],[25750,27600],[31300,32200],[32210,33690],[33700,34990],[35000,36550],[39950,40760],[40770,41820],[41830,43100],[46500,48500],[48510,49930],[49940,51170]],"7":[[30,350],[360,890],[900,1470],[1480,2450],[2460,3410],[3420,4990],[5000,5890],[5900,6530],[6540,7660],[7670,11980],[11990,12320],[12330,12890],[12900,13790],[13800,14960],[14970,15940],[15950,17550],[17560,18270],[18280,19410],[19420,20420],[20430,21930],[21940,22670],[22680,23610],[23620,25570],[25580,27220],[27230,28280],[28290,30240]],"9":[[450,680],[690,1290],[1300,1850],[1860,2890],[2900,3970],[3980,5620],[5630,6480],[6490,7130],[7140,7930],[7940,12340],[12350,12730],[12740,13320],[13330,14180],[14190,15610],[15620,16710],[16720,18710],[18720,19570],[19580,20790],[20800,21820],[21830,23510],[23520,24280],[24290,25460],[25470,26650],[26660,28470],[28480,29630],[29640,30400]]}},{"k":5,"w":[["إِنَّ","inna"],["ٱلَّذِينَ","alladheena"],["يُحَآدُّونَ","yuhaaddoona"],["ٱللَّهَ","l-laha"],["وَرَسُولَهُۥ","warasoolahu"],["كُبِتُوا۟","kubitoo"],["كَمَا","kamaa"],["كُبِتَ","kubita"],["ٱلَّذِينَ","alladheena"],["مِن","min"],["قَبْلِهِمْ ۚ","qablihim"],["وَقَدْ","waqad"],["أَنزَلْنَآ","anzalnaa"],["ءَايَـٰتٍۭ","aayaatin"],["بَيِّنَـٰتٍۢ ۚ","bayyinaatin"],["وَلِلْكَـٰفِرِينَ","walil'kaafireena"],["عَذَابٌۭ","'adhaabun"],["مُّهِينٌۭ","muheenun"]],"en":"Indeed, those who oppose Allah and His Messenger are abased as those before them were abased. And We have certainly sent down verses of clear evidence. And for the disbelievers is a humiliating punishment.","t":{"6":[[200,1430],[1440,3050],[3060,7610],[7620,9040],[9050,11380],[11390,12760],[12770,13690],[13700,14750],[14760,16450],[16460,17490],[17500,19650],[22850,23710],[23720,27480],[27490,30330],[30340,33850],[35300,37950],[37960,40560],[40570,42760]],"12":[[150,1300],[1310,2580],[2590,6430],[6440,7530],[7540,9400],[9410,10600],[16000,16750],[16760,17530],[17540,18790],[18800,19800],[19810,21150],[25950,26520],[26530,29990],[30000,32070],[32080,33800],[39000,40980],[40990,42890],[42900,44050]],"7":[[150,1320],[1330,2280],[2290,6500],[6510,7310],[7320,8580],[8590,9340],[9350,9890],[9900,10480],[10490,11440],[11450,12510],[12520,13990],[14000,14520],[14530,16350],[16360,19380],[19390,20640],[20650,22860],[22870,23530],[23540,26480]],"9":[[200,1370],[1380,2430],[2440,5990],[6000,6840],[6850,8190],[8200,9070],[9080,9690],[9700,10360],[10370,11350],[11360,12120],[12130,13930],[13940,14610],[14620,15930],[15940,19110],[19120,21070],[21080,22930],[22940,23630],[23640,25350]]}},{"k":6,"w":[["يَوْمَ","yawma"],["يَبْعَثُهُمُ","yab'athuhumu"],["ٱللَّهُ","l-lahu"],["جَمِيعًۭا","jamee'an"],["فَيُنَبِّئُهُم","fayunabbi-uhum"],["بِمَا","bimaa"],["عَمِلُوٓا۟ ۚ","'amiloo"],["أَحْصَىٰهُ","ahsaahu"],["ٱللَّهُ","l-lahu"],["وَنَسُوهُ ۚ","wanasoohu"],["وَٱللَّهُ