{"n":64,"verses":[{"k":1,"w":[["يُسَبِّحُ","yusabbihu"],["لِلَّهِ","lillahi"],["مَا","maa"],["فِى","fee"],["ٱلسَّمَـٰوَٰتِ","l-samaawaati"],["وَمَا","wamaa"],["فِى","fee"],["ٱلْأَرْضِ ۖ","l-ardi"],["لَهُ","lahu"],["ٱلْمُلْكُ","l-mul'ku"],["وَلَهُ","walahu"],["ٱلْحَمْدُ ۖ","l-hamdu"],["وَهُوَ","wahuwa"],["عَلَىٰ","'alaa"],["كُلِّ","kulli"],["شَىْءٍۢ","shayin"],["قَدِيرٌ","qadeerun"]],"en":"Whatever is in the heavens and whatever is on the earth is exalting Allah. To Him belongs dominion, and to Him belongs [all] praise, and He is over all things competent.","t":{"6":[[150,1680],[1690,3170],[3180,3790],[3800,4160],[4170,6530],[6540,7460],[7470,7860],[7870,9450],[10750,11310],[11320,12650],[12660,13640],[13650,15300],[16100,16910],[16920,17920],[17930,18940],[18950,20990],[21000,23030]],"12":[[300,1320],[1330,2500],[2510,2950],[2960,3200],[3210,5060],[5070,5830],[5840,6180],[6190,7200],[11500,11880],[11890,12910],[12920,13630],[13640,14650],[17700,18220],[18230,18920],[18930,19670],[19680,21160],[21170,22490]],"7":[[30,1000],[1010,2030],[2040,2340],[2350,2560],[2570,4070],[4080,4640],[4650,4910],[4920,5740],[5750,6130],[6140,6980],[6990,7560],[7570,8440],[8450,9050],[9060,9630],[9640,10290],[10300,12020],[12030,14280]],"9":[[250,1150],[1160,2070],[2080,2400],[2410,2590],[2600,4000],[4010,4550],[4560,4800],[4810,6030],[6040,6460],[6470,7210],[7220,7760],[7770,9170],[9180,9810],[9820,10270],[10280,10870],[10880,12130],[12140,13050]]}},{"k":2,"w":[["هُوَ","huwa"],["ٱلَّذِى","alladhee"],["خَلَقَكُمْ","khalaqakum"],["فَمِنكُمْ","faminkum"],["كَافِرٌۭ","kaafirun"],["وَمِنكُم","waminkum"],["مُّؤْمِنٌۭ ۚ","mu'minun"],["وَٱللَّهُ","wal-lahu"],["بِمَا","bimaa"],["تَعْمَلُونَ","ta'maloona"],["بَصِيرٌ","baseerun"]],"en":"It is He who created you, and among you is the disbeliever, and among you is the believer. And Allah, of what you do, is Seeing.","t":{"6":[[300,740],[750,2020],[2030,3620],[3630,5700],[5710,7840],[7850,10680],[10690,12400],[14150,15670],[15680,16710],[16720,18880],[18890,21550]],"12":[[250,530],[540,1480],[1490,2730],[2740,4490],[4500,6150],[6160,8330],[8340,9350],[12200,13320],[13330,14090],[14100,15650],[15660,17070]],"7":[[30,320],[330,1120],[1130,2150],[2160,4020],[4030,5630],[5640,8310],[8320,9520],[9530,10550],[10560,11130],[11140,12420],[12430,14420]],"9":[[250,510],[520,1190],[1200,2230],[2240,3540],[3550,5030],[5040,7180],[7190,8400],[8500,9360],[9370,9930],[9940,11130],[11140,12030]]}},{"k":3,"w":[["خَلَقَ","khalaqa"],["ٱلسَّمَـٰوَٰتِ","l-samaawaati"],["وَٱلْأَرْضَ","wal-arda"],["بِٱلْحَقِّ","bil-haqi"],["وَصَوَّرَكُمْ","wasawwarakum"],["فَأَحْسَنَ","fa-ahsana"],["صُوَرَكُمْ ۖ","suwarakum"],["وَإِلَيْهِ","wa-ilayhi"],["ٱلْمَصِيرُ","l-maseer"]],"en":"He created the heavens and earth in truth and formed you and perfected your forms; and to Him is the [final] destination.","t":{"6":[[800,1600],[1610,4030],[4040,5610],[5620,7160],[7170,9410],[9420,10990],[11000,13050],[14000,15560],[15570,18030]],"12":[[250,830],[840,2700],[2710,3880],[3890,5180],[5190,7010],[7020,8240],[8250,9750],[13100,14270],[14280,15960]],"7":[[150,650],[660,2090],[2100,3050],[3060,4060],[4070,5450],[5460,6420],[6430,7550],[7560,8560],[8570,10800]],"9":[[300,830],[840,2270],[2280,3230],[3240,4190],[4200,5580],[5590,6540],[6550,8170],[8180,9160],[9170,10220]]}},{"k":4,"w":[["يَعْلَمُ","ya'lamu"],["مَا","maa"],["فِى","fee"],["ٱلسَّمَـٰوَٰتِ","l-samaawaati"],["وَٱلْأَرْضِ","wal-ardi"],["وَيَعْلَمُ","waya'lamu"],["مَا","maa"],["تُسِرُّونَ","tusirroona"],["وَمَا","wamaa"],["تُعْلِنُونَ ۚ","tu''linoona"],["وَٱللَّهُ","wal-lahu"],["عَلِيمٌۢ","'aleemun"],["بِذَاتِ","bidhaati"],["ٱلصُّدُورِ","l-sudoor"]],"en":"He knows what is within the heavens and earth and knows what you conceal and what you declare. And Allah is Knowing of that within the breasts.","t":{"6":[[300,1600],[1610,2170],[2180,2520],[2530,5030],[5040,6620],[6630,8380],[8390,8980],[8990,11190],[11200,12210],[12220,15250],[17450,18880],[18890,21080],[21090,22500],[22510,25070]],"12":[[250,1180],[1190,1590],[1600,1880],[1890,3830],[3840,5080],[5090,6480],[6490,6880],[6890,8540],[8550,9350],[9360,11050],[14900,15980],[15990,17710],[17720,18760],[18770,20380]],"7":[[140,1020],[1030,1270],[1280,1490],[1500,2940],[2950,3940],[3950,5020],[5030,5270],[5280,6570],[6580,7120],[7130,10070],[10080,11050],[11060,12800],[12810,13600],[13610,15960]],"9":[[250,1070],[1080,1330],[1340,1520],[1530,2970],[2980,3950],[3960,5030],[5040,5270],[5280,6570],[6580,7080],[7090,8840],[8850,9810],[9820,11240],[11250,11990],[12000,12940]]}},{"k":5,"w":[["أَلَمْ","alam"],["يَأْتِكُمْ","yatikum"],["نَبَؤُا۟","naba-u"],["ٱلَّذِينَ","alladheena"],["كَفَرُوا۟","kafaroo"],["مِن","min"],["قَبْلُ","qablu"],["فَذَاقُوا۟","fadhaaqoo"],["وَبَالَ","wabaala"],["أَمْرِهِمْ","amrihim"],["وَلَهُمْ","walahum"],["عَذَابٌ","'adhaabun"],["أَلِيمٌۭ","aleemun"]],"en":"Has there not come to you the news of those who disbelieved before? So they tasted the bad consequence of their affair, and they will have a painful punishment.","t":{"6":[[500,1210],[1220,2830],[2840,3830],[3840,5370],[5380,6930],[6940,8050],[8060,9040],[9050,11060],[11070,12150],[12160,13810],[13820,15050],[15060,16970],[16980,18870]],"12":[[350,840],[850,2080],[2090,2910],[2920,4130],[4140,5290],[5300,6300],[6310,7010],[7020,8600],[8610,9570],[9580,10900],[10910,11870],[11880,13280],[13290,14430]],"7":[[30,540],[550,1530],[1540,2140],[2150,3120],[3130,3930],[3940,4940],[4950,5520],[5530,6540],[6550,7340],[7350,8310],[8320,9080],[9090,10160],[10170,12410]],"9":[[450,890],[900,1810],[1820,2480],[2490,3370],[3380,4200],[4210,5080],[5090,5720],[5730,6810],[6820,7550],[7560,8510],[8520,9260],[9270,10320],[10330,11000]]}},{"k":6,"w":[["ذَٰلِكَ","dhaalika"],["بِأَنَّهُۥ","bi-annahu"],["كَانَت","kaanat"],["تَّأْتِيهِمْ","tateehim"],["رُسُلُهُم","rusuluhum"],["بِٱلْبَيِّنَـٰتِ","bil-bayinaati"],["فَقَالُوٓا۟","faqaaloo"],["أَبَشَرٌۭ","abasharun"],["يَهْدُونَنَا","yahdoonanaa"],["فَكَفَرُوا۟","fakafaroo"],["وَتَوَلَّوا۟ ۚ","watawallaw"],["وَّٱسْتَ