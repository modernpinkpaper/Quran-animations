{"n":110,"verses":[{"k":1,"w":[["إِذَا","idhaa"],["جَآءَ","jaaa"],["نَصْرُ","nasru"],["ٱللَّهِ","l-lahi"],["وَٱلْفَتْحُ","wal-fath"]],"en":"When the victory of Allah has come and the conquest,","t":{"6":[[900,1930],[1940,3900],[3910,5030],[5040,6700],[6710,8320]],"12":[[250,1130],[1140,3130],[3140,4040],[4050,5450],[5460,6730]],"7":[[200,680],[690,3590],[3600,4210],[4220,5140],[5150,6210]],"9":[[250,910],[920,3310],[3320,4400],[4410,5200],[5210,6330]]}},{"k":2,"w":[["وَرَأَيْتَ","wara-ayta"],["ٱلنَّاسَ","l-naasa"],["يَدْخُلُونَ","yadkhuloona"],["فِى","fee"],["دِينِ","deeni"],["ٱللَّهِ","l-lahi"],["أَفْوَاجًۭا","afwaajan"]],"en":"And you see the people entering into the religion of Allah in multitudes,","t":{"6":[[700,2410],[2420,4240],[4250,6250],[6260,7200],[7210,8280],[8290,9780],[9790,11820]],"12":[[300,1840],[1850,3410],[3420,5180],[5190,6000],[6010,6980],[6990,8320],[8330,10330]],"7":[[30,1070],[1080,2620],[2630,3870],[3880,4330],[4340,5080],[5090,5920],[5930,7430]],"9":[[400,1660],[1670,3200],[3210,4770],[4780,5380],[5390,6210],[6220,7320],[7330,8920]]}},{"k":3,"w":[["فَسَبِّحْ","fasabbih"],["بِحَمْدِ","bihamdi"],["رَبِّكَ","rabbika"],["وَٱسْتَغْفِرْهُ ۚ","wa-is'taghfir'hu"],["إِنَّهُۥ","innahu"],["كَانَ","kaana"],["تَوَّابًۢا","tawwaaban"]],"en":"Then exalt [Him] with praise of your Lord and ask forgiveness of Him. Indeed, He is ever Accepting of repentance.","t":{"6":[[400,2040],[2050,3460],[3470,5090],[5100,7650],[8900,11170],[11180,12310],[12320,14740]],"12":[[40,1420],[1430,2760],[2770,4150],[4160,6150],[10000,11820],[11830,12830],[12840,14560]],"7":[[30,1010],[1020,1790],[1800,2730],[2740,4570],[4580,6350],[6360,7070],[7080,8750]],"9":[[500,1770],[1780,2750],[2760,3920],[3930,6200],[6400,8150],[8160,8950],[8960,10600]]}}]}