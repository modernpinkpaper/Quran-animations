{"n":84,"verses":[{"k":1,"w":[["إِذَا","idhaa"],["ٱلسَّمَآءُ","l-samaau"],["ٱنشَقَّتْ","inshaqqat"]],"en":"When the sky has split [open]","t":{"6":[[550,1020],[1030,3890],[3900,6650]],"12":[[250,600],[610,3450],[3460,5510]],"7":[[30,350],[360,3260],[3270,5030]],"9":[[300,680],[690,3590],[3600,5470]]}},{"k":2,"w":[["وَأَذِنَتْ","wa-adhinat"],["لِرَبِّهَا","lirabbihaa"],["وَحُقَّتْ","wahuqqat"]],"en":"And has responded to its Lord and was obligated [to do so]","t":{"6":[[200,1670],[1680,3900],[3910,5980]],"12":[[300,1600],[1610,3520],[3530,5250]],"7":[[30,960],[970,2160],[2170,3250]],"9":[[450,1830],[1840,3570],[3580,4900]]}},{"k":3,"w":[["وَإِذَا","wa-idhaa"],["ٱلْأَرْضُ","l-ardu"],["مُدَّتْ","muddat"]],"en":"And when the earth has been extended","t":{"6":[[200,1050],[1060,2320],[2330,4410]],"12":[[450,1160],[1170,2500],[2510,3930]],"7":[[30,590],[600,1460],[1470,2300]],"9":[[30,800],[810,1990],[2000,3060]]}},{"k":4,"w":[["وَأَلْقَتْ","wa-alqat"],["مَا","maa"],["فِيهَا","feehaa"],["وَتَخَلَّتْ","watakhallat"]],"en":"And has cast out that within it and relinquished [it]","t":{"6":[[250,1790],[1800,2550],[2560,4230],[4240,6430]],"12":[[350,1850],[1860,2400],[2410,3770],[3780,5850]],"7":[[30,1000],[1010,1350],[1360,2230],[2240,3530]],"9":[[400,1680],[1690,2350],[2360,3620],[3630,5290]]}},{"k":5,"w":[["وَأَذِنَتْ","wa-adhinat"],["لِرَبِّهَا","lirabbihaa"],["وَحُقَّتْ","wahuqqat"]],"en":"And has responded to its Lord and was obligated [to do so] -","t":{"6":[[300,1780],[1790,4130],[4140,6010]],"12":[[300,1620],[1630,3690],[3700,5520]],"7":[[30,980],[990,2190],[2200,3250]],"9":[[450,1840],[1850,3670],[3680,5040]]}},{"k":6,"w":[["يَـٰٓأَيُّهَا","yaaayyuhaa"],["ٱلْإِنسَـٰنُ","l-insaanu"],["إِنَّكَ","innaka"],["كَادِحٌ","kaadihun"],["إِلَىٰ","ilaa"],["رَبِّكَ","rabbika"],["كَدْحًۭا","kadhan"],["فَمُلَـٰقِيهِ","famulaaqeeh"]],"en":"O mankind, indeed you are laboring toward your Lord with [great] exertion and will meet it.","t":{"6":[[200,3340],[3350,5960],[5970,7710],[7720,94