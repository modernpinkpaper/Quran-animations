60],[3070,4360],[4370,6740],[6750,7580]],"9":[[300,2190],[2200,2870],[2880,3970],[3980,6020],[6030,8080],[8090,9150]]}},{"k":11,"w":[["فَسَوْفَ","fasawfa"],["يَدْعُوا۟","yad'oo"],["ثُبُورًۭا","thubooran"]],"en":"He will cry out for destruction","t":{"6":[[400,1620],[1630,3050],[3060,4740]],"12":[[250,1280],[1290,2450],[2460,3980]],"7":[[30,710],[720,1540],[1550,2770]],"9":[[400,1430],[1440,2670],[2680,4400]]}},{"k":12,"w":[["وَيَصْلَىٰ","wayaslaa"],["سَعِيرًا","sa'eeran"]],"en":"And [enter to] burn in a Blaze.","t":{"6":[[450,2200],[2210,4090]],"12":[[300,1640],[1650,3180]],"7":[[50,930],[940,2220]],"9":[[200,1620],[1630,3270]]}},{"k":13,"w":[["إِنَّهُۥ","innahu"],["كَانَ","kaana"],["فِىٓ","fee"],["أَهْلِهِۦ","ahlihi"],["مَسْرُورًا","masrooran"]],"en":"Indeed, he had [once] been among his people in happiness;","t":{"6":[[500,2480],[2490,3690],[3700,5500],[5510,7260],[7270,9320]],"12":[[400,2140],[2150,3160],[3170,4910],[4920,6520],[6530,8330]],"7":[[30,1660],[1670,2330],[2340,3970],[3980,5000],[5010,6380]],"9":[[210,2150],[2160,3060],[3070,4580],[4590,6100],[6110,8100]]}},{"k":14,"w":[["إِنَّهُۥ","innahu"],["ظَنَّ","zanna"],["أَن","an"],["لَّن","lan"],["يَحُورَ","yahoor"]],"en":"Indeed, he had thought he would never return [to Allah].","t":{"6":[[300,2270],[2280,3730],[3740,4050],[4060,5780],[5790,7810]],"12":[[200,2030],[2040,3280],[3290,3590],[3600,4980],[4990,6400]],"7":[[30,1540],[1550,3100],[3110,3320],[3330,4830],[4840,7460]],"9":[[550,2550],[2560,3790],[3800,4250],[4260,5880],[5890,6810]]}},{"k":15,"w":[["بَلَىٰٓ","balaa"],["إِنَّ","inna"],["رَبَّهُۥ","rabbahu"],["كَانَ","kaana"],["بِهِۦ","bihi"],["بَصِيرًۭا","baseeran"]],"en":"But yes! Indeed, his Lord was ever of him, Seeing.","t":{"6":[[1000,2700],[3440,4680],[4690,6450],[6460,7610],[7620,8750],[8760,10500]],"12":[[350,1300],[4240,5360],[5370,6920],[6930,7960],[7970,8970],[8980,10660]],"7":[[30,1280],[1290,2400],[2410,3420],[3430,4070],[4080,4720],[4730,5950]],"9":[[500,830],[840,4000],[4010,5510],[5520,64