{"n":86,"verses":[{"k":1,"w":[["وَٱلسَّمَآءِ","wal-samaai"],["وَٱلطَّارِقِ","wal-taariq"]],"en":"By the sky and the night comer -","t":{"6":[[120,3200],[3210,5150]],"12":[[300,3310],[3320,4950]],"7":[[30,3170],[3180,4400]],"9":[[500,3500],[3510,5350]]}},{"k":2,"w":[["وَمَآ","wamaa"],["أَدْرَىٰكَ","adraaka"],["مَا","maa"],["ٱلطَّارِقُ","l-taariq"]],"en":"And what can make you know what is the night comer?","t":{"6":[[210,2170],[2180,3950],[3960,4270],[4280,6060]],"12":[[150,1920],[1930,3570],[3580,3800],[3810,5460]],"7":[[30,2080],[2090,3180],[3190,3350],[3360,4410]],"9":[[350,2630],[2640,4020],[4030,4190],[4200,5790]]}},{"k":3,"w":[["ٱلنَّجْمُ","al-najmu"],["ٱلثَّاقِبُ","l-thaaqib"]],"en":"It is the piercing star -","t":{"6":[[30,1930],[1940,3590]],"12":[[350,2140],[2150,3690]],"7":[[30,1960],[1970,3060]],"9":[[200,2100],[2110,3500]]}},{"k":4,"w":[["إِن","in"],["كُلُّ","kullu"],["نَفْسٍۢ","nafsin"],["لَّمَّا","lammaa"],["عَلَيْهَا","'alayhaa"],["حَافِظٌۭ","haafizun"]],"en":"There is no soul but that it has over it a protector.","t":{"6":[[30,1100],[1110,2140],[2150,3200],[3210,5110],[5120,7240],[7250,8620]],"12":[[350,1300],[1310,2350],[2360,3330],[3340,5140],[5150,6830],[6840,8170]],"7":[[30,1010],[1020,1750],[1760,2440],[2450,4270],[4280,5380],[5390,6320]],"9":[[400,1490],[1500,2400],[2410,3290],[3300,5000],[5010,6560],[6570,7690]]}},{"k":5,"w":[["فَلْيَنظُرِ","falyanzuri"],["ٱلْإِنسَـٰنُ","l-insaanu"],["مِمَّ","mimma"],["خُلِقَ","khuliq"]],"en":"So let man observe from what he was created.","t":{"6":[[350,2630],[2640,5180],[5190,6500],[6510,7470]],"12":[[300,2270],[2280,4690],[4700,5810],[5820,6640]],"7":[[30,2090],[2100,4190],[4200,5600],[5610,6270]],"9":[[40,2210],[2220,4500],[4510,5760],[5770,6650]]}},{"k":6,"w":[["خُلِقَ","khuliqa"],["مِن","min"],["مَّآءٍۢ","maain"],["دَافِقٍۢ","daafiqin"]],"en":"He was created from a fluid, ejected,","t":{"6":[[150,1070],[1080,2310],[2320,5320],[5330,6700]],"12":[[250,1090],[1100,2060],[2070,4660],[4670,5760]],"7":[[30,66