{"n":107,"verses":[{"k":1,"w":[["أَرَءَيْتَ","ara-ayta"],["ٱلَّذِى","alladhee"],["يُكَذِّبُ","yukadhibu"],["بِٱلدِّينِ","bil-deen"]],"en":"Have you seen the one who denies the Recompense?","t":{"6":[[150,1600],[1610,3050],[3060,4780],[4790,6940]],"12":[[150,1470],[1480,2880],[2890,4440],[4450,5360]],"7":[[150,1020],[1030,1810],[1820,2930],[2940,5710]],"9":[[400,1520],[1530,2510],[2520,3890],[3900,5170]]}},{"k":2,"w":[["فَذَٰلِكَ","fadhaalika"],["ٱلَّذِى","alladhee"],["يَدُعُّ","yadu''u"],["ٱلْيَتِيمَ","l-yateem"]],"en":"For that is the one who drives away the orphan","t":{"6":[[200,1780],[1790,3310],[3320,4560],[4570,7070]],"12":[[40,1500],[1510,2830],[2840,3970],[3980,5700]],"7":[[30,1060],[1070,1920],[1930,2760],[2770,5890]],"9":[[250,1350],[1360,2480],[2490,3420],[3430,4670]]}},{"k":3,"w":[["وَلَا","walaa"],["يَحُضُّ","yahuddu"],["عَلَىٰ","'alaa"],["طَعَامِ","ta'aami"],["ٱلْمِسْكِينِ","l-mis'keen"]],"en":"And does not encourage the feeding of the poor.","t":{"6":[[200,1060],[1070,2400],[2410,3480],[3490,5100],[5110,7920]],"12":[[250,1050],[1060,2230],[2240,3200],[3210,4550],[4560,5790]],"7":[[150,710],[720,1560],[1570,2200],[2210,3140],[3150,6570]],"9":[[200,850],[860,1880],[1890,2660],[2670,3830],[3840,5290]]}},{"k":4,"w":[["فَوَيْلٌۭ","fawaylun"],["لِّلْمُصَلِّينَ","lil'musalleen"]],"en":"So woe to those who pray","t":{"6":[[400,2060],[2070,5650]],"12":[[30,1520],[1530,3920]],"7":[[30,1170],[1180,5180]],"9":[[200,1520],[1530,3430]]}},{"k":5,"w":[["ٱلَّذِينَ","alladheena"],["هُمْ","hum"],["عَن","'an"],["صَلَاتِهِمْ","salaatihim"],["سَاهُونَ","saahoon"]],"en":"[But] who are heedless of their prayer -","t":{"6":[[400,2420],[2430,3140],[3150,3940],[3950,6700],[6710,9420]],"12":[[30,1690],[1700,2290],[2300,3230],[3240,5200],[5210,7050]],"7":[[50,1210],[1220,1630],[1640,2690],[2700,4030],[4040,6910]],"9":[[300,1720],[1730,2230],[2240,2970],[2980,4920],[4930,6290]]}},{"k":6,"w":[["ٱلَّذِينَ","alladheena"],["هُمْ","hum"],["يُرَآءُونَ","yuraaoon"]],"en":"Those who make